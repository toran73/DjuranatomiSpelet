<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DjuranatomiSpelet.BoardEditorWindow"
        Icon="/Assets/icon.ico"
        Title="Djuranatomi Spelet – Bild &amp; rutor" Width="1500" Height="900" MinWidth="800" MinHeight="450"
        WindowState="Maximized" WindowStartupLocation="CenterOwner" Background="#FFF8F0">
    <Grid ColumnDefinitions="*,360">

        <DockPanel Grid.Column="0" Margin="12">
            <Border DockPanel.Dock="Top" Background="#FFF1D6" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#5C4D4D">
                    <Run FontWeight="Bold" Text="Så här gör du: " />
                    <Run Text="1) Välj en bild. 2) Skapa kroppsdelarna till höger. 3) Markera en kroppsdel och klicka på bilden i den ordning spelarna ska gå. Första rutan blir START, sista rutan blir MÅL. Klicka på en ruta för att markera den – nya rutor läggs då in efter den. Dra för att flytta. Högerklick på bilden lägger ut en tom ljusgrå ruta utan fråga (eller kryssa i “Lägg ut tomma rutor”). Sista rutan måste ha en kroppsdel. Högerklick på en ruta, eller Delete, tar bort den. Esc avmarkerar." />
                </TextBlock>
            </Border>
            <Border Background="White" BorderBrush="#E0D6CC" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Viewbox x:Name="BoardHost" Stretch="Uniform" Margin="6" />
                    <TextBlock x:Name="NoImageText" Text="Ingen bild vald – klicka på “Välj bild…” till höger."
                               FontSize="22" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </DockPanel>

        <Border Grid.Column="1" Background="White" BorderBrush="#E0D6CC" BorderThickness="2,0,0,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                        <Button Content="Spara" Theme="{StaticResource BigButton}" Background="#16A34A" Click="Save_Click" />
                        <Button Content="Stäng" Theme="{StaticResource BigButton}" Background="#6C757D" Click="Close_Click" />
                    </UniformGrid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Djurets namn" FontSize="16" FontWeight="SemiBold" />
                        <TextBox x:Name="NameBox" FontSize="18" Margin="0,4,0,10" />

                        <Button Content="Välj bild…" Theme="{StaticResource BigButton}" FontSize="16" Padding="12,6" Background="#3D5A80" Click="ChooseImage_Click" />

                        <TextBlock Text="Rutornas storlek" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <Slider x:Name="SizeSlider" Minimum="0.012" Maximum="0.07" SmallChange="0.002" LargeChange="0.005" Margin="0,0,0,8" />

                        <TextBlock Text="Kroppsdelar" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Markerad kroppsdel används för nya rutor." FontSize="12" Foreground="#888" />
                        <CheckBox x:Name="EmptyModeCheck" Content="Lägg ut tomma rutor (ljusgrå, ingen fråga)" FontSize="14" Margin="0,4,0,0"
                                  IsCheckedChanged="EmptyModeCheck_Changed" />
                        <ListBox x:Name="PartsList" MinHeight="120" MaxHeight="230" Margin="0,4,0,6" FontSize="16" />
                        <TextBlock Text="Namn på markerad kroppsdel" FontSize="13" Foreground="#666" />
                        <TextBox x:Name="PartNameBox" FontSize="16" Margin="0,2,0,6" />
                        <WrapPanel>
                            <Button Content="+ Ny kroppsdel" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#2A9D8F" Click="AddPart_Click" />
                            <Button Content="Byt färg" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#9B5DE5" Click="CycleColor_Click" />
                            <Button Content="Ta bort" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#D62828" Click="DeletePart_Click" />
                        </WrapPanel>

                        <TextBlock Text="Markerad ruta" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock x:Name="SelectedSpaceText" FontSize="15" Margin="0,4,0,6" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="AssignPartButton" Content="Ge rutan markerad kroppsdel" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#3D5A80" Click="AssignPart_Click" />
                            <Button x:Name="MakeEmptyButton" Content="Gör rutan tom" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#8A8A8A" Click="MakeEmpty_Click" />
                            <Button x:Name="DeleteSpaceButton" Content="Ta bort rutan" Theme="{StaticResource BigButton}" HorizontalAlignment="Left" FontSize="14" Padding="10,5" Background="#D62828" Click="DeleteSpace_Click" />
                        </WrapPanel>
                        <Button Content="Ta bort alla rutor" Theme="{StaticResource BigButton}" FontSize="13" Padding="10,4" Background="#6C757D"
                                HorizontalAlignment="Left" Margin="4,12,4,4" Click="ClearSpaces_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
